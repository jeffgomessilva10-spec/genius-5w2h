// Genius Consultoria – Plano de Ação 5W2H (v2)
// Prisma Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COLLABORATOR   // operacional: vê suas atividades
  CLIENT         // cliente externo: vê indicadores do seu projeto
  ADMIN          // acesso total + dashboard executivo
  EXECUTIVE      // gestor/c-level: dashboard executivo, sem edição
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  DELAYED
  DONE
}

enum NotificationType {
  DEADLINE_WARNING
  DEADLINE_EXCEEDED
  STATUS_CHANGE
  RISK_ALERT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RaciRole {
  RESPONSIBLE   // executa
  ACCOUNTABLE   // responsável final
  CONSULTED     // consultado
  INFORMED      // informado
}

enum AttachmentType {
  IMAGE
  DOCUMENT
  LINK
  VIDEO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
}

// ─────────────────────────────────────────
// ENTIDADE: Usuário
// ─────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(COLLABORATOR)
  avatarUrl    String?  @map("avatar_url")
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dashboardPrefs    Json?     @map("dashboard_prefs")   // preferências de KPIs
  activities        Activity[]
  projects          ProjectUser[]
  notifications     Notification[]
  notificationsSent Notification[]  @relation("SentNotifications")
  comments          Comment[]
  auditLogs         AuditLog[]
  raciEntries       Raci[]
  timeEntries       TimeEntry[]
  attachments       Attachment[]
  documents         Document[]
  objectives        Objective[]
  pdcaReviews       PdcaReview[]
  lessons           LessonLearned[]
  consents          Consent[]
  glossaryCreated   GlossaryTerm[]  @relation("GlossaryCreated")
  glossaryUpdated   GlossaryTerm[]  @relation("GlossaryUpdated")
  dataPolicies      DataPolicy[]

  @@map("users")
}

// ─────────────────────────────────────────
// ENTIDADE: Projeto
// ─────────────────────────────────────────
model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  categories  Category[]
  users       ProjectUser[]
  auditLogs   AuditLog[]
  documents   Document[]
  objectives  Objective[]
  pdcaReviews PdcaReview[]
  lessons     LessonLearned[]

  @@map("projects")
}

model ProjectUser {
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_users")
}

// ─────────────────────────────────────────
// ENTIDADE: Categoria
// ─────────────────────────────────────────
model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @default("#F04E00")
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("categories")
}

// ─────────────────────────────────────────
// ENTIDADE: Atividade (núcleo do 5W2H)
// ─────────────────────────────────────────
model Activity {
  id   String @id @default(uuid())
  code String

  // ── 5W2H ──────────────────────
  what      String
  why       String
  who       String
  where     String
  how       String
  howMuch   Decimal?  @map("how_much")    // Custo estimado
  whenStart DateTime? @map("when_start")
  whenEnd   DateTime? @map("when_end")
  // ──────────────────────────────

  status        ActivityStatus @default(PLANNED)
  notes         String?

  // ── Financeiro ampliado ────────
  actualCost    Decimal? @map("actual_cost")     // Custo realizado
  plannedHours  Decimal? @map("planned_hours")   // Horas planejadas
  actualHours   Decimal? @map("actual_hours")    // Horas realizadas

  // ── Matriz de riscos ───────────
  risk              String?    // Descrição do risco
  riskProbability   Int?       @map("risk_probability")  // 1-5
  riskImpact        Int?       @map("risk_impact")       // 1-5
  riskLevel         RiskLevel? @map("risk_level")        // calculado
  riskMitigation    String?    @map("risk_mitigation")   // ação mitigadora

  categoryId    String  @map("category_id")
  responsibleId String? @map("responsible_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  responsible   User?              @relation(fields: [responsibleId], references: [id])
  notifications Notification[]
  comments      Comment[]
  auditLogs     AuditLog[]
  raciEntries   Raci[]
  timeEntries   TimeEntry[]
  attachments   Attachment[]
  documents     Document[]
  keyResults    ActivityKeyResult[]

  @@map("activities")
}

// ─────────────────────────────────────────
// ENTIDADE: Comentário (com @menção)
// ─────────────────────────────────────────
model Comment {
  id         String   @id @default(uuid())
  content    String
  activityId String   @map("activity_id")
  authorId   String   @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ─────────────────────────────────────────
// ENTIDADE: Log de Auditoria
// ─────────────────────────────────────────
model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  entity     String      // "Activity", "Project", "User", etc.
  entityId   String      @map("entity_id")
  userId     String      @map("user_id")
  before     Json?       // estado anterior
  after      Json?       // estado posterior
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])
  activity   Activity?   @relation(fields: [entityId], references: [id], map: "audit_activity_fk")
  project    Project?    @relation(fields: [entityId], references: [id], map: "audit_project_fk")

  @@map("audit_logs")
}

// ─────────────────────────────────────────
// ENTIDADE: Glossário de Negócios
// ─────────────────────────────────────────
model GlossaryTerm {
  id          String   @id @default(uuid())
  term        String   @unique
  definition  String
  category    String   @default("Geral")
  examples    String?
  relatedTo   String?  @map("related_to")
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User  @relation("GlossaryCreated", fields: [createdById], references: [id])
  updatedBy User? @relation("GlossaryUpdated", fields: [updatedById], references: [id])

  @@map("glossary_terms")
}

// ─────────────────────────────────────────
// ENTIDADE: Política de Dados
// ─────────────────────────────────────────
model DataPolicy {
  id          String   @id @default(uuid())
  title       String
  category    String   // "Classificação", "Acesso", "Retenção", "Privacidade"
  content     String
  version     String   @default("1.0")
  isActive    Boolean  @default(true) @map("is_active")
  effectiveAt DateTime @default(now()) @map("effective_at")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("data_policies")
}

// ─────────────────────────────────────────
// ENTIDADE: Consentimento LGPD
// ─────────────────────────────────────────
model Consent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   // "terms", "privacy", "marketing"
  accepted    Boolean
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// ─────────────────────────────────────────
// ENUM: Fases PDCA
// ─────────────────────────────────────────
enum PdcaPhase {
  PLAN
  DO
  CHECK
  ACT
}

// ─────────────────────────────────────────
// ENTIDADE: Objetivo (OKR)
// ─────────────────────────────────────────
model Objective {
  id          String    @id @default(uuid())
  title       String
  description String?
  projectId   String    @map("project_id")
  targetDate  DateTime? @map("target_date")
  progress    Decimal   @default(0)   // 0-100
  isActive    Boolean   @default(true) @map("is_active")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id])
  keyResults KeyResult[]

  @@map("objectives")
}

// ─────────────────────────────────────────
// ENTIDADE: Resultado-Chave (OKR)
// ─────────────────────────────────────────
model KeyResult {
  id          String    @id @default(uuid())
  objectiveId String    @map("objective_id")
  title       String
  unit        String    @default("%")  // %, R$, unidades, etc.
  targetValue Decimal   @map("target_value")
  currentValue Decimal  @default(0) @map("current_value")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  objective   Objective            @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  activities  ActivityKeyResult[]

  @@map("key_results")
}

// ─────────────────────────────────────────
// JUNÇÃO: Atividade ↔ Resultado-Chave
// ─────────────────────────────────────────
model ActivityKeyResult {
  activityId  String @map("activity_id")
  keyResultId String @map("key_result_id")

  activity  Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@id([activityId, keyResultId])
  @@map("activity_key_results")
}

// ─────────────────────────────────────────
// ENTIDADE: Revisão PDCA
// ─────────────────────────────────────────
model PdcaReview {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  phase       PdcaPhase
  title       String
  description String
  actionItems String?   @map("action_items")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("pdca_reviews")
}

// ─────────────────────────────────────────
// ENTIDADE: Lição Aprendida
// ─────────────────────────────────────────
model LessonLearned {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  title       String
  description String
  category    String   @default("Geral")  // Técnico, Processo, Equipe, etc.
  impact      String?
  recommendation String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("lessons_learned")
}

// ─────────────────────────────────────────
// ENTIDADE: RACI por atividade
// ─────────────────────────────────────────
model Raci {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  userId     String   @map("user_id")
  role       RaciRole
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@map("raci")
}

// ─────────────────────────────────────────
// ENTIDADE: Apontamento de Horas
// ─────────────────────────────────────────
model TimeEntry {
  id          String   @id @default(uuid())
  activityId  String   @map("activity_id")
  userId      String   @map("user_id")
  hours       Decimal
  date        DateTime
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

// ─────────────────────────────────────────
// ENTIDADE: Anexo / Evidência
// ─────────────────────────────────────────
model Attachment {
  id           String         @id @default(uuid())
  activityId   String         @map("activity_id")
  name         String
  url          String         // URL do arquivo ou link externo
  type         AttachmentType @default(DOCUMENT)
  description  String?
  uploadedById String         @map("uploaded_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}

// ─────────────────────────────────────────
// ENTIDADE: Documento de Projeto
// ─────────────────────────────────────────
model Document {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  activityId   String?  @map("activity_id")
  name         String
  url          String
  version      String   @default("1.0")
  description  String?
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

// ─────────────────────────────────────────
// ENTIDADE: Notificação
// ─────────────────────────────────────────
model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false) @map("is_read")
  sentAt     DateTime?        @map("sent_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentById   String?          @map("sent_by_id")
  sentBy     User?            @relation("SentNotifications", fields: [sentById], references: [id])

  activityId String?          @map("activity_id")
  activity   Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@map("notifications")
}
